        "padding": [{ "top": 12, "bottom": 12, "left": 14, "right": 14 }],
        "title": [{ "fontSize": 12, "fontColor": { "solid": { "color": "#0b0b0b" } } }]
      }
    },
    "columnChart": {
      "*": {
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#e1e0d9" } }, "gridlineThickness": 1 }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#52514e" } } }]
      }
    },
    "barChart": {
      "*": {
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#e1e0d9" } }, "gridlineThickness": 1 }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#52514e" } } }]
      }
    }
